# Copie este arquivo para .env.local e preencha com seus valores reais.
# .env.local NUNCA deve ser commitado (ja esta no .gitignore).

# String de conexao do Postgres. No Neon, mantenha sslmode=require.
# Para um PostgreSQL local, use a URL sem o parametro sslmode=require.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Segredo usado pelo NextAuth para assinar sessoes/JWT
AUTH_SECRET=
